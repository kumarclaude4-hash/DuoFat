<?xml version="1.0" encoding="utf-8"?>
<!--
  Unread-count badge for the scroll-to-bottom FAB.
  A ring in the chat background colour separates the badge from the FAB gradient
  underneath it, so a 1-2 digit count stays legible where the two overlap.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_accent"/>
    <corners android:radius="9dp"/>
    <stroke
        android:width="1.5dp"
        android:color="@color/ds_toolbar"/>
</shape>
