<?xml version="1.0" encoding="utf-8"?>
<!-- Top gradient: opaque brand-dark (#191620) → transparent.
     Sits over both the remote video and the voice-only background, giving the
     header row (partner name, duration, audio picker) a legible surface without
     a hard-edged box.  The brand dark matches ds_background so it blends
     into the voice-only screen seamlessly. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#E6191620"
        android:endColor="#00191620" />
</shape>
