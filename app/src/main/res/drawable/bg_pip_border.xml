<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-corner border overlaid on top of the SurfaceViewRenderer in the
     PiP.  SurfaceView doesn't clip-to-outline on all devices, so this View
     draws the illusion of rounded corners on top of the square video surface.
     Google Meet's self tile has no coloured glow — just a hairline neutral edge
     that separates the tile from the feed behind it, so this uses a subtle
     ~20 %-opacity white stroke instead of the old lavender ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners android:radius="16dp" />
</shape>
