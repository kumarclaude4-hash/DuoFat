<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded-corner border overlaid on top of the SurfaceViewRenderer in the
     PiP.  SurfaceView doesn't clip-to-outline on all devices, so this View
     draws the illusion of rounded corners.
     Uses a 55 %-opacity lavender accent stroke so the PiP subtly glows with
     the brand colour rather than a generic white ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke android:width="1.5dp" android:color="#8C9A81FF" />
    <corners android:radius="14dp" />
</shape>
