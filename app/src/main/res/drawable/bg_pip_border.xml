<?xml version="1.0" encoding="utf-8"?>
<!-- Thin rounded border overlaid on top of the SurfaceViewRenderer in the PiP to give the
     appearance of corner clipping (SurfaceView doesn't clip to outline on all devices). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke android:width="1dp" android:color="#44FFFFFF" />
    <corners android:radius="12dp" />
</shape>
