<?xml version="1.0" encoding="utf-8"?>
<!-- Local video PiP container — Google Meet 1:1 self-tile look.
     A near-black fill sits behind the self video so the tile reads as a solid
     rounded card while frames are still arriving, with 16 dp corners to match
     Meet's self-view rounding. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#12151C" />
    <corners android:radius="16dp" />
</shape>
