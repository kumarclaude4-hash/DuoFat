<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_input_bg" />
            <stroke
                android:width="@dimen/ds_input_border_width"
                android:color="@color/ds_input_border_focus" />
            <corners android:radius="@dimen/ds_corner_radius_input" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_input_bg" />
            <stroke
                android:width="@dimen/ds_input_border_width"
                android:color="@color/ds_input_border" />
            <corners android:radius="@dimen/ds_corner_radius_input" />
        </shape>
    </item>
</selector>
