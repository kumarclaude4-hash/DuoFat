<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon for encrypted-message notifications (NotificationStyler).

  Replaces a 1.44 MB 1254x1254 ic_secure.png. That PNG was not merely oversized:
  it was saved as PNG colour type 2 (RGB, no alpha channel, no tRNS chunk), and
  Android draws a notification small icon as an ALPHA MASK — colour is discarded
  and replaced by the system accent/status-bar tint. A fully opaque source
  therefore masked to a solid rectangle, so the status bar showed a filled blob
  rather than a logo. The shape below carries its silhouette in the alpha
  channel, which is what the platform actually reads.

  Drawn at the 24dp / 24-unit viewport used by the sibling small icons
  (ic_call_phone, ic_lock) so all three notification types align optically in the
  status bar, and left untinted so the platform supplies the correct per-surface
  colour on both light and dark system themes.

  fillType="evenOdd" punches the keyhole out as a true hole in a single path.
  Two separate paths would not work: for an alpha mask, overlapping opaque
  subpaths merge instead of subtracting, so the keyhole would vanish. evenOdd
  requires API 24; minSdk is 26.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="@android:color/white"
        android:fillType="evenOdd"
        android:pathData="M12,1L3,5v6c0,5.55 3.84,10.74 9,12 5.16,-1.26 9,-6.45 9,-12V5L12,1z M12,8.2C13.105,8.2 14,9.095 14,10.2C14,10.95 13.63,11.61 13.06,12.01L12.85,15L11.15,15L10.94,12.01C10.37,11.61 10,10.95 10,10.2C10,9.095 10.895,8.2 12,8.2z" />

</vector>
