<?xml version="1.0" encoding="utf-8"?>
<!-- Circular control button (Camera, Mute, Chat, Flip).
     ds_surface (#24202E) fill with a 1 dp lavender-accent stroke so the
     buttons feel part of the brand palette rather than generic dark circles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#24202E" />
    <stroke android:width="1dp" android:color="#4A3A75" />
</shape>
