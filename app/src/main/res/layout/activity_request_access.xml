<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dn_background">

    <!-- ── Back arrow ── -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/dn_accent"
        android:contentDescription="Back"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- ── Logo mark ── -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_logo_duoshield"
        android:contentDescription="DuoShield"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"/>

    <!-- ── Title ── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="DuoShield is invite-only"
        android:textColor="@color/dn_text_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Subtitle / status message ── -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Enter the single-use invite code provided by a DuoShield administrator."
        android:textColor="@color/dn_text_subtitle"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Admin-issued invite code ── -->
    <EditText
        android:id="@+id/inputInvite"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:hint="Invite code"
        android:inputType="textNoSuggestions"
        android:imeOptions="actionDone"
        android:singleLine="true"
        android:autofillHints=""
        android:textColor="@color/dn_text_title"
        android:textColorHint="@color/dn_text_subtitle"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="16dp"
        android:backgroundTint="@color/dn_accent"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Error text ── -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ds_danger"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/inputInvite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Progress indicator ── -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressAccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/dn_accent"
        app:trackColor="@color/dn_progress_track"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnPrimary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Primary action ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrimary"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Validate invite"
        android:textColor="@color/dn_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:backgroundTint="@color/dn_button_tint"
        app:cornerRadius="28dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="36dp"
        android:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
