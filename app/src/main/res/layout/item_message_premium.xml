<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_spacing_m"
    android:paddingEnd="@dimen/ds_spacing_m"
    android:paddingTop="@dimen/ds_spacing_s"
    android:paddingBottom="@dimen/ds_spacing_s">

    <!-- Pin indicator row — subtle and protective -->
    <LinearLayout
        android:id="@+id/pinIndicatorRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_spacing_s"
        android:paddingBottom="@dimen/ds_spacing_xs"
        android:visibility="gone">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_pin"
            android:tint="@color/ds_accent"
            android:layout_marginEnd="@dimen/ds_spacing_xs"
            android:contentDescription="Pinned"/>

        <TextView
            android:id="@+id/pinIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pinned"
            android:textAppearance="@style/TextAppearance.DuoShield.Label"
            android:textColor="@color/ds_accent"/>
    </LinearLayout>

    <!-- Sender label — for group chats, subtle -->
    <TextView
        android:id="@+id/senderLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.DuoShield.Label"
        android:textColor="@color/ds_accent"
        android:paddingStart="@dimen/ds_spacing_s"
        android:paddingBottom="@dimen/ds_spacing_xs"
        android:visibility="gone"/>

    <!-- Bubble wrapper — organic and breathing -->
    <FrameLayout
        android:id="@+id/bubbleWrapper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/messageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ds_bubble_padding_h"
            android:paddingEnd="@dimen/ds_bubble_padding_h"
            android:paddingTop="@dimen/ds_bubble_padding_v"
            android:paddingBottom="@dimen/ds_bubble_padding_v"
            android:maxWidth="300dp"
            android:background="@drawable/bg_bubble_theirs_sanctuary">

            <!-- Reply preview — contextual and clear -->
            <LinearLayout
                android:id="@+id/replyPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_reply_preview"
                android:layout_marginBottom="@dimen/ds_spacing_m"
                android:minHeight="48dp"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:minHeight="48dp"
                    android:background="@color/ds_accent"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/ds_spacing_m"
                    android:paddingEnd="@dimen/ds_spacing_m"
                    android:paddingTop="@dimen/ds_spacing_s"
                    android:paddingBottom="@dimen/ds_spacing_s">

                    <TextView
                        android:id="@+id/replyAuthorText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DuoShield.Label"
                        android:textStyle="bold"
                        android:textColor="@color/ds_accent"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/replyPreviewText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DuoShield.BodyMedium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Text message — readable and comfortable -->
            <TextView
                android:id="@+id/messageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.DuoShield.ChatMessage"
                android:visibility="gone"/>

            <!-- Image message — premium presentation -->
            <ImageView
                android:id="@+id/messageImage"
                android:layout_width="240dp"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:contentDescription="Image"
                android:background="@drawable/bg_media_rounded"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:visibility="gone"/>

            <!-- Video message — elegant player -->
            <FrameLayout
                android:id="@+id/videoContainer"
                android:layout_width="240dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_media_rounded"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/videoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#FF0D1825"
                    android:contentDescription="Video"/>

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_button_primary_sanctuary">

                    <ImageView
                        android:id="@+id/videoPlayBtn"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_play_video"
                        android:tint="@color/ds_text_on_accent"
                        android:contentDescription="Play video"/>
                </FrameLayout>
            </FrameLayout>

            <!-- Contact card — premium presentation -->
            <LinearLayout
                android:id="@+id/contactCardContainer"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="@dimen/ds_spacing_m"
                android:gravity="center_vertical"
                android:background="@drawable/bg_conversation_item_sanctuary"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_person"
                    android:tint="@color/ds_accent"
                    android:layout_marginEnd="@dimen/ds_spacing_m"
                    android:contentDescription="Contact"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/cardName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DuoShield.Body"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/cardUid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.DuoShield.Label"
                        android:layout_marginTop="2dp"/>

                    <Button
                        android:id="@+id/cardCopyBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Copy ID"
                        android:textSize="10sp"
                        android:textColor="@color/ds_accent"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:paddingStart="0dp"
                        android:paddingEnd="0dp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Encryption indicator + timestamp row — subtle and informative -->
            <LinearLayout
                android:id="@+id/footerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="@dimen/ds_spacing_xs">

                <!-- Encryption indicator -->
                <ImageView
                    android:id="@+id/encryptionIndicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shield"
                    android:tint="@color/ds_accent"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="Encrypted"/>

                <!-- Timestamp -->
                <TextView
                    android:id="@+id/messageTimestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.DuoShield.Timestamp"
                    android:layout_marginEnd="4dp"/>

                <!-- Delivery status -->
                <ImageView
                    android:id="@+id/deliveryStatus"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_check"
                    android:tint="@color/ds_accent"
                    android:contentDescription="Delivered"/>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
