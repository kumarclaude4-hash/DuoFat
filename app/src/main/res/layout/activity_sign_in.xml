<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDEAF8">

    <!-- ── Logo mark ── -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_logo_duoshield"
        android:contentDescription="DuoShield"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginTop="64dp"/>

    <!-- ── Hero tagline ── -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Privacy in\nyour pocket."
        android:textColor="#13112A"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:layout_marginTop="28dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bubbleContainer"/>

    <!-- ── Chat bubble area ── -->
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/tvTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnCreate">

        <!-- bubble1: "Welcome to DuoShield 👋" white card -->
        <TextView
            android:id="@+id/bubble1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome to DuoShield 👋"
            android:textColor="#13112A"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            android:background="@drawable/bg_onboarding_welcome_card"
            android:visibility="invisible"
            android:layout_marginBottom="10dp"/>

        <!-- bubble2: second message (animated in after bubble1) -->
        <TextView
            android:id="@+id/bubble2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:maxWidth="280dp"
            android:text="DuoShield is engineered to protect your privacy."
            android:textColor="#13112A"
            android:textSize="15sp"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:background="@drawable/bg_bubble_mine"
            android:visibility="invisible"/>
    </LinearLayout>

    <!-- ── Create account CTA ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Create account"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:backgroundTint="#7B63FB"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="end"
        app:iconTint="#FFFFFF"
        app:iconSize="20dp"
        app:cornerRadius="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRestore"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:elevation="0dp"/>

    <!-- ── Restore / sign in ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRestore"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="I have an account"
        android:textColor="#7B63FB"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:backgroundTint="#00000000"
        app:strokeColor="#7B63FB"
        app:strokeWidth="1.5dp"
        app:cornerRadius="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTerms"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp"
        android:elevation="0dp"/>

    <!-- ── Terms footer ── -->
    <TextView
        android:id="@+id/tvTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="By using this service, you agree to our\nTerms of Service and Privacy Policy"
        android:textColor="#9898B0"
        android:textSize="12sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="32dp"
        android:paddingHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
