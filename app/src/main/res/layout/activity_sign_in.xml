<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <!-- Ambient top glow -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.15"
        android:background="@drawable/glow_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0"
        android:translationY="-80dp"/>

    <!-- ── Logo mark ── -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_logo_duoshield"
        android:contentDescription="DuoShield"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintVertical_chainStyle="packed"/>

    <!-- ── Hero tagline ── -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Privacy in\nyour pocket."
        android:textAppearance="@style/TextAppearance.DuoShield.Display"
        android:gravity="center"
        android:layout_marginTop="@dimen/ds_spacing_xl"
        android:paddingHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bubbleContainer"/>

    <!-- ── Chat bubbles preview ── -->
    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:layout_marginTop="36dp"
        app:layout_constraintTop_toBottomOf="@id/tvTagline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnCreate">

        <TextView
            android:id="@+id/bubble1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:text="Welcome to DuoShield 👋"
            android:textAppearance="@style/TextAppearance.DuoShield.ChatMessage"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:background="@drawable/bg_bubble_theirs_sanctuary"
            android:visibility="invisible"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/bubble2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:maxWidth="280dp"
            android:text="DuoShield is engineered to protect your privacy."
            android:textAppearance="@style/TextAppearance.DuoShield.ChatMessage"
            android:textColor="@color/ds_text_on_accent"
            android:paddingHorizontal="18dp"
            android:paddingVertical="13dp"
            android:background="@drawable/bg_bubble_mine_sanctuary"
            android:visibility="invisible"/>
    </LinearLayout>

    <!-- ── Create account CTA ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCreate"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Create account"
        android:textAppearance="@style/TextAppearance.DuoShield.Button"
        android:textColor="@color/ds_text_on_accent"
        android:backgroundTint="@color/ds_accent"
        app:cornerRadius="@dimen/ds_corner_radius_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnRestore"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"/>

    <!-- ── Already have an account ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRestore"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="I have an account"
        android:textAppearance="@style/TextAppearance.DuoShield.Button"
        android:textColor="@color/ds_accent"
        android:backgroundTint="@color/transparent"
        app:strokeColor="@color/ds_accent"
        app:strokeWidth="1.5dp"
        app:cornerRadius="@dimen/ds_corner_radius_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvTerms"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="14dp"/>

    <!-- ── Terms footer ── -->
    <TextView
        android:id="@+id/tvTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="By using this service, you agree to our\nTerms of Service and Privacy Policy"
        android:textAppearance="@style/TextAppearance.DuoShield.Caption"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="30dp"
        android:paddingHorizontal="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
