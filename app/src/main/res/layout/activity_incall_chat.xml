<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ds_background">

    <!-- ── Header row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- Chevron-down: return to call -->
        <ImageView
            android:id="@+id/btnMinimizeChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_down"
            android:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to call" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="In-call messages"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Close -->
        <ImageView
            android:id="@+id/btnCloseChat"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Close chat" />
    </LinearLayout>

    <!-- ── Ephemeral notice banner ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_incall_notice">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            android:tint="#9A81FF"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Messages won\'t be saved when the call ends."
            android:textColor="#BBBBBB"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ── Message list ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInCallMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <!-- ── Footer note ── -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Everyone in the call can see your messages"
        android:textColor="@color/ds_text_caption"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="4dp"
        android:paddingBottom="4dp" />

    <!-- ── Input row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <ImageView
            android:id="@+id/btnEmoji"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_emoji"
            android:tint="@color/ds_text_tertiary"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Emoji" />

        <EditText
            android:id="@+id/etInCallMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_incall_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Type a message..."
            android:textColorHint="@color/ds_text_tertiary"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="textCapSentences"
            android:maxLines="3"
            android:imeOptions="actionSend"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/btnSendInCall"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_send"
            android:background="@drawable/bg_fab"
            android:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Send" />
    </LinearLayout>

</LinearLayout>
