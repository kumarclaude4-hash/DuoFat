<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fitsSystemWindows="true">

    <!-- Ambient glow -->
    <View
        android:id="@+id/glow_view"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:alpha="0"
        android:background="@drawable/glow_circle"
        app:layout_constraintBottom_toBottomOf="@id/shield_left"
        app:layout_constraintEnd_toEndOf="@id/shield_left"
        app:layout_constraintStart_toStartOf="@id/shield_left"
        app:layout_constraintTop_toTopOf="@id/shield_left"/>

    <!-- Shield left half -->
    <ImageView
        android:id="@+id/shield_left"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_shield_left_half"
        android:contentDescription="Shield left"
        app:layout_constraintBottom_toTopOf="@id/tvWordmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.40"/>

    <!-- Shield right half -->
    <ImageView
        android:id="@+id/shield_right"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_shield_right_half"
        android:contentDescription="Shield right"
        app:layout_constraintTop_toTopOf="@id/shield_left"
        app:layout_constraintBottom_toBottomOf="@id/shield_left"
        app:layout_constraintStart_toStartOf="@id/shield_left"
        app:layout_constraintEnd_toEndOf="@id/shield_left"/>

    <!-- Lock icon -->
    <ImageView
        android:id="@+id/lock_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:alpha="0"
        android:src="@drawable/ic_lock"
        app:tint="@color/ds_background"
        android:contentDescription="Locked"
        app:layout_constraintTop_toTopOf="@id/shield_left"
        app:layout_constraintBottom_toBottomOf="@id/shield_left"
        app:layout_constraintStart_toStartOf="@id/shield_left"
        app:layout_constraintEnd_toEndOf="@id/shield_left"
        app:layout_constraintVertical_bias="0.58"/>

    <!-- Wordmark -->
    <TextView
        android:id="@+id/tvWordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:alpha="0"
        android:text="DuoShield"
        android:textColor="@color/ds_text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.02"
        android:translationY="20dp"
        app:layout_constraintBottom_toTopOf="@id/tvTagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/shield_left"/>

    <!-- Tagline -->
    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0"
        android:text="Secure. Private. Yours."
        android:textColor="@color/ds_accent"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:translationY="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvWordmark"
        app:layout_constraintVertical_bias="0"/>

    <!-- Signal-protocol badge -->
    <LinearLayout
        android:id="@+id/layoutBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:alpha="0"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/ds_text_tertiary"
            android:contentDescription="secure"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Signal Protocol end-to-end encrypted"
            android:textColor="@color/ds_text_tertiary"
            android:textSize="11.5sp"
            android:letterSpacing="0.01"/>
    </LinearLayout>

    <!-- Version label -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:alpha="0"
        android:textColor="@color/ds_text_caption"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
