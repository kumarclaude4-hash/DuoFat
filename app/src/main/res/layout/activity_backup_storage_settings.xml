<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ds_toolbar"
        app:title="Backup &amp; Storage"
        app:titleTextColor="@color/ds_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- ══ MEDIA STORAGE ══════════════════════════════════════════════ -->
            <TextView
                android:text="MEDIA STORAGE"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="60dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_image"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Backblaze B2"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/tvB2Status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tap Test to verify connection"
                        android:textColor="@color/ds_text_tertiary"
                        android:textSize="12sp"
                        android:layout_marginTop="3dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginStart="14dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestB2"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Test"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="18dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnB2Details"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Details"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:layout_marginStart="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ LOCAL CACHE ═══════════════════════════════════════════════ -->
            <TextView
                android:text="LOCAL CACHE"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:minHeight="60dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_image"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"/>

                <TextView
                    android:id="@+id/tvCacheSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Local cache: calculating…"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="14.5sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCache"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Clear cache"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:layout_marginStart="14dp"
                    app:cornerRadius="18dp"/>
            </LinearLayout>

            <!-- ══ CLOUD BACKUP ══════════════════════════════════════════════ -->
            <TextView
                android:text="CLOUD BACKUP"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:id="@+id/cardBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/ds_surface"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_arrow_down"
                        app:tint="#9A81FF"
                        android:layout_marginEnd="18dp"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvLastBackup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last backup: Checking…"
                            android:textColor="@color/ds_text_primary"
                            android:textSize="14.5sp"/>

                        <TextView
                            android:id="@+id/tvBackupCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Messages backed up: —"
                            android:textColor="@color/ds_text_tertiary"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/tvBackupHealth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone"/>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncBackup"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="Sync now"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="18dp"
                        android:layout_marginStart="14dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginStart="40dp"
                    android:text="End-to-end encrypted with your seed phrase. Only you can decrypt them."
                    android:textColor="@color/ds_text_tertiary"
                    android:textSize="12sp"
                    android:lineSpacingMultiplier="1.4"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
