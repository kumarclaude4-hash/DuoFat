<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="#FFFFFF"
            android:contentDescription="Back"
            android:layout_marginStart="-8dp"
            android:layout_marginBottom="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recovery Phrase"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp" />

        <!-- Description card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recovery Phrase"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use your recovery phrase to load your account on new devices."
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your account cannot be recovered without your recovery phrase. Make sure it&#8217;s stored somewhere safe and secure — and don&#8217;t share it with anyone."
                android:textSize="14sp"
                android:textColor="#CCCCCC"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <!-- Word box (card) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Word grid — populated in code -->
            <GridLayout
                android:id="@+id/gridWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="6" />

        </LinearLayout>

        <!-- Copy / QR buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyPhrase"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Copy"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#00000000"
                app:strokeColor="#444444"
                app:strokeWidth="1dp"
                app:cornerRadius="22dp"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewQr"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="View QR"
                android:textColor="#FFFFFF"
                android:textAllCaps="false"
                android:backgroundTint="#00000000"
                app:strokeColor="#444444"
                app:strokeWidth="1dp"
                app:cornerRadius="22dp" />

        </LinearLayout>

        <!-- Hide recovery phrase card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#111111"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hide Recovery Phrase"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permanently hide your recovery phrase on this device."
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHidePhrase"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hide"
                android:textColor="#FF4444"
                android:textAllCaps="false"
                android:backgroundTint="#00000000"
                app:strokeColor="#FF4444"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- Checkbox acknowledgement -->
        <CheckBox
            android:id="@+id/cbSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I&#8217;ve saved my recovery phrase"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:buttonTint="#9A81FF"
            android:layout_marginBottom="20dp" />

        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="#9A81FF"
            app:trackColor="#2D2938"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="13sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Continue (pill, outline green) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textColor="#9A81FF"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:enabled="false"
            android:backgroundTint="#00000000"
            app:strokeColor="#9A81FF"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
