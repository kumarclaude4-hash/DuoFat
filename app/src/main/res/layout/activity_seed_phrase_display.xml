<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/ds_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Back arrow -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/ds_text_primary"
            android:contentDescription="Back"
            android:layout_marginStart="-8dp"
            android:layout_marginBottom="8dp" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recovery Phrase"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ds_text_primary"
            android:layout_marginBottom="12dp" />

        <!-- Description card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ds_surface"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recovery Phrase"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_accent"
                    android:contentDescription="Secured" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use your recovery phrase to load your account on new devices."
                android:textSize="14sp"
                android:textColor="@color/ds_text_secondary"
                android:lineSpacingMultiplier="1.4"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your account cannot be recovered without your recovery phrase. Make sure it&#8217;s stored somewhere safe and secure — and don&#8217;t share it with anyone."
                android:textSize="14sp"
                android:textColor="@color/ds_text_secondary"
                android:lineSpacingMultiplier="1.4" />

        </LinearLayout>

        <!-- Word box (card) -->
        <LinearLayout
            android:id="@+id/gridWordsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/ds_surface"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <!-- Word grid — populated in code -->
            <GridLayout
                android:id="@+id/gridWords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="6" />

        </LinearLayout>

        <!-- QR button -->
        <!-- Copy-to-clipboard is intentionally NOT offered: the mnemonic must
             never touch the system clipboard. Transfer to a new device via QR. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewQr"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="View QR"
                android:textColor="@color/ds_text_primary"
                android:textAllCaps="false"
                android:backgroundTint="@color/transparent"
                app:strokeColor="@color/ds_divider"
                app:strokeWidth="1dp"
                app:cornerRadius="22dp" />

        </LinearLayout>

        <!-- Hide recovery phrase card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/ds_surface"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hide Recovery Phrase"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ds_text_primary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hide the words from view. Tap again to show them."
                    android:textSize="13sp"
                    android:textColor="@color/ds_text_secondary"
                    android:lineSpacingMultiplier="1.3" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHidePhrase"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hide"
                android:textColor="@color/ds_danger"
                android:textAllCaps="false"
                android:backgroundTint="@color/transparent"
                app:strokeColor="@color/ds_danger"
                app:strokeWidth="1dp"
                app:cornerRadius="18dp"
                android:layout_marginStart="12dp" />

        </LinearLayout>

        <!-- Checkbox acknowledgement -->
        <CheckBox
            android:id="@+id/cbSaved"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I&#8217;ve saved my recovery phrase"
            android:textColor="@color/ds_text_primary"
            android:textSize="15sp"
            android:buttonTint="@color/ds_accent"
            android:layout_marginBottom="20dp" />

        <!-- Progress -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/ds_accent"
            app:trackColor="@color/ds_surface_2"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_text_secondary"
            android:textSize="13sp"
            android:textAlignment="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Continue (pill, outline accent) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Continue"
            android:textColor="@color/ds_accent"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:textAllCaps="false"
            android:enabled="false"
            android:backgroundTint="@color/transparent"
            app:strokeColor="@color/ds_accent"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp" />

    </LinearLayout>
</ScrollView>
