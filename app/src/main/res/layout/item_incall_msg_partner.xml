<?xml version="1.0" encoding="utf-8"?>
<!-- Partner message bubble (left-aligned, dark) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="64dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Partner initial avatar -->
    <TextView
        android:id="@+id/tvPartnerAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_avatar_circle"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_incall_bubble_partner"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Partner display name -->
        <TextView
            android:id="@+id/tvPartnerSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9A81FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <!-- Message text -->
        <TextView
            android:id="@+id/tvPartnerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/tvPartnerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:textColor="#888888"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
