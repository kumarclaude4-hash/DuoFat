<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ds_background">

    <!-- ── Header row ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageView
            android:id="@+id/btnMinimizeWatch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_down"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Back to call" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Watch Together"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <ImageView
            android:id="@+id/btnCloseWatch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="End watch together" />
    </LinearLayout>

    <!-- ── Ephemeral notice banner ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_incall_notice">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lock"
            app:tint="#9A81FF"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="The video plays on each device directly from YouTube. This session ends when the call ends."
            android:textColor="#BBBBBB"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ── Player surface ── -->
    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:background="#000000">

        <com.duoshield.app.call.watch.WatchTogetherPlayerView
            android:id="@+id/watchPlayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!--
          Shown before a session starts, after it ends, and when the local player refuses the
          video. Opaque, not transparent: it is stacked on top of the WebView, and a see-through
          overlay let its copy composite with whatever the page was still displaying (live video,
          a paused frame, or YouTube's "This video is unavailable" card) into one unreadable
          pile of overlapping text. The Activity also hides the player whenever this is visible;
          the solid background is the belt to that braces.
        -->
        <TextView
            android:id="@+id/tvPlayerPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:gravity="center"
            android:padding="24dp"
            android:text="Search YouTube or paste a link below to start watching together."
            android:textColor="#CCCCCC"
            android:textSize="15sp" />

        <!--
          Search results overlay.

          It sits inside playerContainer, above the player, so results cover the video area
          while browsing and reveal it again on dismiss. That keeps the picker on one screen
          (no second Activity, no change to the session/sync architecture) and means an
          already-playing session is never torn down just because someone searched.

          Opaque background: a translucent panel over a playing video is unreadable.
        -->
        <FrameLayout
            android:id="@+id/searchPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ds_background"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSearchResults"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"
                android:scrollbars="vertical"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/searchProgress"
                style="?android:attr/progressBarStyle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Covers TOO_SHORT, EMPTY and ERROR; the Activity supplies the copy. -->
            <LinearLayout
                android:id="@+id/searchMessageBox"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvSearchMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.3" />

                <Button
                    android:id="@+id/btnSearchRetry"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:minWidth="96dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    android:textColor="#9A81FF"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </FrameLayout>

    <!-- ── Who is watching ── -->
    <TextView
        android:id="@+id/tvWatchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/ds_text_caption"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="4dp" />

    <!-- ── Playback controls (visible during an active session) ── -->
    <LinearLayout
        android:id="@+id/watchControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/btnSeekBack"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:text="-10s"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:contentDescription="Rewind 10 seconds" />

        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:src="@drawable/ic_play_audio"
            android:padding="14dp"
            android:background="@drawable/bg_call_btn_circle"
            app:tint="#FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Play or pause" />

        <Button
            android:id="@+id/btnSeekForward"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="64dp"
            android:text="+10s"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:contentDescription="Forward 10 seconds" />

        <Button
            android:id="@+id/btnPlaybackRate"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="56dp"
            android:text="1x"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:contentDescription="Change playback speed" />

        <!--
          Mutes the VIDEO on this device only — never the call, and never the other
          participant's video. The video already plays attenuated so voices sit on top of it;
          this is the escape hatch for when someone needs the video silent entirely (to talk,
          or to listen to the call audio alone) without pausing playback for both people.

          Deliberately device-local and never written to the session document: muting is a
          personal listening choice, unlike play/pause/seek/rate which are shared intent.
        -->
        <Button
            android:id="@+id/btnWatchMute"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:minWidth="56dp"
            android:text="Vol"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:contentDescription="Mute or unmute the video on this device" />
    </LinearLayout>

    <!-- ── Start / change video input row ── -->
    <LinearLayout
        android:id="@+id/watchStartRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <!--
          One field, two jobs: a YouTube URL/ID starts a session immediately (the original
          behaviour, unchanged), anything else is treated as a search query.

          inputType is plain text rather than textUri because the field is now primarily a
          search box — textUri suppresses the keyboard's word suggestions and spellcheck,
          which is wrong for typing "lofi beats" and right for almost nothing here. Pasting a
          link still works identically. imeOptions=actionSearch matches what the key now does.
        -->
        <EditText
            android:id="@+id/etWatchUrl"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_incall_input"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:hint="Search YouTube or paste a link..."
            android:textColorHint="@color/ds_text_tertiary"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionSearch"
            android:gravity="center_vertical" />

        <Button
            android:id="@+id/btnStartWatch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:background="@drawable/bg_fab"
            android:text="Go"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:contentDescription="Search YouTube or open the pasted link" />
    </LinearLayout>

</LinearLayout>
