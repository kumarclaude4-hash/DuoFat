<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/group_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ds_toolbar"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp"
        android:elevation="6dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:padding="12dp"
            app:tint="@color/text_primary"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="4dp">

            <TextView
                android:id="@+id/tv_group_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/tv_member_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_hint"
                android:textSize="12sp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Message list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>

    <!-- Typing bar -->
    <LinearLayout
        android:id="@+id/row_typing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingBottom="4dp"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Someone is typing…"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:textStyle="italic"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"/>

    <!-- Upload progress (visible only during media uploads) -->
    <LinearLayout
        android:id="@+id/groupUploadProgressContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_surface_2"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/groupUploadProgress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="72dp"
            android:layout_height="4dp"
            android:progressTint="@color/accent"
            android:indeterminate="true"/>

        <ImageView
            android:id="@+id/groupUploadThumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="10dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_media_rounded"
            android:visibility="gone"
            android:contentDescription="Media being uploaded"/>

        <TextView
            android:id="@+id/tvGroupUploadPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:text="Uploading…"/>
    </LinearLayout>

    <!-- ── Input bar ── -->
    <LinearLayout
        android:id="@+id/group_input_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp"
        android:paddingTop="4dp"
        android:background="@android:color/transparent">

        <!-- Field: emoji (left) + text + attach (right) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field_whatsapp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <!-- Emoji / keyboard toggle -->
            <ImageView
                android:id="@+id/group_emoji_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_emoji"
                android:padding="10dp"
                app:tint="@color/ds_text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Emoji"/>

            <!-- Text input -->
            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Message group…"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textSize="15sp"
                android:maxLines="4"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionNone"/>

            <!-- Camera stays inside the compose field, like WhatsApp -->
            <FrameLayout
                android:id="@+id/group_camera_container"
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/btn_group_camera_inline"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:src="@drawable/ic_camera"
                    app:tint="@color/ds_text_secondary"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Camera"/>
            </FrameLayout>

            <!-- Attach (right of field) -->
            <ImageView
                android:id="@+id/btn_group_attach"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_attach"
                android:padding="10dp"
                app:tint="@color/ds_text_secondary"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach media"/>
        </LinearLayout>

        <!-- Send FAB -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_send_button_whatsapp">

            <ImageView
                android:id="@+id/btn_send"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_send"
                android:padding="13dp"
                app:tint="@color/white"
                android:contentDescription="Send"/>
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
