<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dn_background">

    <!-- ── Logo mark ── -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_logo_duoshield"
        android:contentDescription="DuoShield"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="56dp"/>

    <!-- ── Title ── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Set an app PIN"
        android:textColor="@color/dn_text_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginTop="48dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Subtitle ── -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="A PIN is required to use DuoShield. It locks the app on this device — it is never sent anywhere, and only you know it."
        android:textColor="@color/dn_text_subtitle"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.5"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etNewPin"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:hint="New PIN (4–6 digits)"
        android:textColorHint="@color/dn_text_hint"
        android:textColor="@color/dn_text_title"
        android:gravity="center"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:background="@drawable/bg_onboarding_input"
        android:layout_marginTop="36dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/etConfirmPin"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:hint="Confirm PIN"
        android:textColorHint="@color/dn_text_hint"
        android:textColor="@color/dn_text_title"
        android:gravity="center"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:background="@drawable/bg_onboarding_input"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/etNewPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Error text ── -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/ds_danger"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="14dp"
        android:layout_marginHorizontal="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Continue button ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:text="Set PIN"
        android:textColor="@color/dn_accent"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:backgroundTint="@color/dn_button_tint"
        app:cornerRadius="28dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="36dp"
        android:elevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
