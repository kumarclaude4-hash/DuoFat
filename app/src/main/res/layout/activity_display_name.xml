<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ── Back arrow ─────────────────────────────────────────── -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_arrow_back"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:tint="#FFFFFF"
        android:contentDescription="Back"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ── Logo ──────────────────────────────────────────────── -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_logo_duoshield"
        android:contentDescription="DuoShield"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- ── Title ─────────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pick your display name"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="64dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/ivLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Subtitle ──────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="It can be your real name, an alias, or anything else you like — and you can change it at any time."
        android:textColor="#AAAAAA"
        android:textSize="15sp"
        android:lineSpacingMultiplier="1.4"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Name input ─────────────────────────────────────────── -->
    <EditText
        android:id="@+id/etDisplayName"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:hint="Enter your display name"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        android:textSize="15sp"
        android:fontFamily="monospace"
        android:background="@drawable/bg_input_session"
        android:paddingHorizontal="18dp"
        android:paddingVertical="0dp"
        android:inputType="textPersonName"
        android:imeOptions="actionDone"
        android:maxLines="1"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="28dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Error text ─────────────────────────────────────────── -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FF4444"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="28dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/etDisplayName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Progress ──────────────────────────────────────────── -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressSetup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="#00F782"
        app:trackColor="#1A1A1A"
        android:layout_marginBottom="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnContinue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Continue button ────────────────────────────────────── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="Continue"
        android:textColor="#00F782"
        android:textSize="16sp"
        android:fontFamily="sans-serif-medium"
        android:textAllCaps="false"
        android:backgroundTint="#00000000"
        app:strokeColor="#00F782"
        app:strokeWidth="1.5dp"
        app:cornerRadius="28dp"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
