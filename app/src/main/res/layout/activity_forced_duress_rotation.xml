<?xml version="1.0" encoding="utf-8"?>
<!--
  Screen 2 of the forced post-unfreeze rotation (S06-M6) — re-arms slot B with
  a fresh code. No toolbar back arrow, no cancel button: unlike
  ManageUnlockCodesActivity (opt-in, from Settings), this screen is mandatory
  and always shown once rotationRequired is true, regardless of the
  server-side duress-eligibility flag — the account only reaches this screen
  because slot B was already armed and used to trigger a real wipe. See
  ForcedDuressRotationActivity for the retry-safe completion logic.

  Deliberately generic chrome, same reasoning as activity_manage_unlock_codes.xml:
  nothing here names or hints at the code's actual behavior except inside
  panelExplain, shown once.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- ── Logo mark (mirrors the primary-PIN screen's chrome) ── -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="40dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_logo_duoshield"
            android:contentDescription="DuoShield"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="Set a second code"
            android:textColor="@color/ds_text_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="One more step before you continue: set a second unlock code for this account."
            android:textColor="@color/ds_text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.3"/>

        <!-- ══ ENTRY PANEL (new code + confirm) ═══════════════════════════ -->
        <LinearLayout
            android:id="@+id/panelEntry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="28dp">

            <EditText
                android:id="@+id/etNewCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="New code (4–6 digits)"
                android:textColorHint="@color/ds_text_tertiary"
                android:textColor="@color/ds_text_primary"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="10dp"/>

            <EditText
                android:id="@+id/etConfirmCode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Confirm code"
                android:textColorHint="@color/ds_text_tertiary"
                android:textColor="@color/ds_text_primary"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:background="@drawable/bg_input_field"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="18dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinueEntry"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Continue"
                android:textAllCaps="false"
                app:cornerRadius="24dp"/>

            <!-- No cancel button — this screen is mandatory. -->
        </LinearLayout>

        <!-- ══ EXPLANATION PANEL (shown once, before the code is saved) ══ -->
        <LinearLayout
            android:id="@+id/panelExplain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:text="BEFORE YOU CONTINUE"
                style="@style/SectionHeader"
                android:paddingStart="0dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Entering this code at the lock screen unlocks the app like normal — but it also signs you out and clears everything stored on this device. Your account and messages are safe and can be restored later with your recovery phrase.\n\nUse this if you're ever asked to unlock your phone under pressure and want to protect what's on it.\n\nThis explanation is only shown once. There is nothing else in the app that refers to this."
                android:textColor="@color/ds_text_secondary"
                android:textSize="13.5sp"
                android:lineSpacingMultiplier="1.35"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmExplain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="I understand — save this code"
                android:textAllCaps="false"
                app:cornerRadius="24dp"/>

            <!-- No cancel button — this screen is mandatory. -->
        </LinearLayout>

        <!-- ══ ACK-RETRY PANEL (server acknowledgement failed) ═══════════ -->
        <LinearLayout
            android:id="@+id/panelAckRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your codes were saved on this device, but we couldn't confirm the update with the server. Check your connection and try again."
                android:textColor="@color/ds_text_secondary"
                android:textSize="13.5sp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryAck"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:text="Try again"
                android:textAllCaps="false"
                app:cornerRadius="24dp"/>
        </LinearLayout>

        <!-- ── Status / error text ── -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:textColor="@color/ds_danger"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
