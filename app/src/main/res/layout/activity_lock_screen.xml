<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock Screen — Lavender light redesign.
  IDs kept for LockScreenActivity.java: tvError, btnUnlock (GONE), btnBiometric,
  pinDotsView. New IDs: numpad key views via tag-based lookup in Java.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="40dp"
        android:paddingBottom="32dp"
        android:paddingHorizontal="24dp">

        <!-- ── Shield logo ── -->
        <ImageView
            android:id="@+id/ivLockShield"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/ds_accent"
            android:contentDescription="DuoShield"/>

        <!-- App name -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name"
            android:textColor="@color/ls_key_text"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/lock_tagline"
            android:textColor="@color/ls_tagline"
            android:textSize="13sp"/>

        <!-- ── Lock icon with concentric rings ── -->
        <FrameLayout
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp">

            <!-- Outermost ring (most faint) -->
            <View
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:alpha="0.12"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Middle ring -->
            <View
                android:layout_width="165dp"
                android:layout_height="165dp"
                android:layout_gravity="center"
                android:alpha="0.22"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Inner ring -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:alpha="0.35"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Lock icon circle — ivLockShield and fingerprintScanView swap here -->
            <FrameLayout
                android:id="@+id/flLockIcon"
                android:layout_width="82dp"
                android:layout_height="82dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_lock_icon_circle">

                <!-- Lock icon — shown by default, hidden during biometric scan -->
                <ImageView
                    android:id="@+id/ivLockShield"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="4dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_accent"
                    android:contentDescription="Locked"/>

                <!-- Fingerprint scan animation — shown during biometric scan -->
                <com.duoshield.app.ui.FingerprintScanView
                    android:id="@+id/fingerprintScanView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>

            </FrameLayout>

        </FrameLayout>

        <!-- ── "Enter your PIN" ── -->
        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/enter_pin"
            android:textColor="@color/ls_enter_pin"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"/>

        <!-- ── PIN dots ── -->
        <com.duoshield.app.ui.PinDotsView
            android:id="@+id/pinDotsView"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="12dp"
            android:clickable="false"
            android:focusable="false"/>

        <!-- Error message -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ds_danger"
            android:textSize="13sp"
            android:gravity="center"
            android:minHeight="18dp"
            android:visibility="invisible"/>

        <!-- ── Custom numpad ── -->
        <LinearLayout
            android:id="@+id/llNumpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: 1, 2, 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <LinearLayout android:id="@+id/key1"
                    style="@style/NumpadKey">
                    <TextView android:text="1" style="@style/NumpadDigit"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key2"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="14dp">
                    <TextView android:text="2" style="@style/NumpadDigit"/>
                    <TextView android:text="ABC" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key3"
                    style="@style/NumpadKey">
                    <TextView android:text="3" style="@style/NumpadDigit"/>
                    <TextView android:text="DEF" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: 4, 5, 6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <LinearLayout android:id="@+id/key4"
                    style="@style/NumpadKey">
                    <TextView android:text="4" style="@style/NumpadDigit"/>
                    <TextView android:text="GHI" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key5"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="14dp">
                    <TextView android:text="5" style="@style/NumpadDigit"/>
                    <TextView android:text="JKL" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key6"
                    style="@style/NumpadKey">
                    <TextView android:text="6" style="@style/NumpadDigit"/>
                    <TextView android:text="MNO" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 3: 7, 8, 9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="10dp">

                <LinearLayout android:id="@+id/key7"
                    style="@style/NumpadKey">
                    <TextView android:text="7" style="@style/NumpadDigit"/>
                    <TextView android:text="PQRS" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key8"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="14dp">
                    <TextView android:text="8" style="@style/NumpadDigit"/>
                    <TextView android:text="TUV" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key9"
                    style="@style/NumpadKey">
                    <TextView android:text="9" style="@style/NumpadDigit"/>
                    <TextView android:text="WXYZ" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 4: [empty], 0, [backspace] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- empty slot -->
                <View
                    android:layout_width="72dp"
                    android:layout_height="72dp"/>

                <LinearLayout android:id="@+id/key0"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="14dp">
                    <TextView android:text="0" style="@style/NumpadDigit"/>
                </LinearLayout>

                <!-- Backspace key -->
                <FrameLayout
                    android:id="@+id/keyBackspace"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_numpad_backspace"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Delete">
                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_backspace_ls"
                        android:contentDescription="Backspace"/>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Hidden unlock button kept for backward-compat with Java refs -->
        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- ── Biometric button ── -->
        <LinearLayout
            android:id="@+id/btnBiometric"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="28dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"
            android:contentDescription="Use biometrics">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_fingerprint"
                app:tint="@color/ds_accent"
                android:contentDescription="Fingerprint"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/use_biometric"
                android:textColor="@color/ds_accent"
                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
