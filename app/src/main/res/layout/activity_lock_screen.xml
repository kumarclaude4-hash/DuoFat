<?xml version="1.0" encoding="utf-8"?>
<!--
  IDs kept exactly as LockScreenActivity.java expects:
    etPin, tvError, btnUnlock, btnBiometric
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background"
    android:fitsSystemWindows="true">

    <!-- Ambient glow behind shield -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.25"
        android:background="@drawable/glow_circle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.2"/>

    <!-- Shield icon wrapped in FrameLayout for FingerprintScanView overlay -->
    <FrameLayout
        android:id="@+id/lockIconFrame"
        android:layout_width="120dp"
        android:layout_height="140dp"
        android:layout_marginTop="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvLockTitle"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintVertical_bias="0.3">

        <com.duoshield.app.ui.FingerprintScanView
            android:id="@+id/fingerprintScanView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <ImageView
            android:id="@+id/ivLockShield"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_shield"
            app:tint="@color/ds_accent"
            android:contentDescription="DuoShield"/>

    </FrameLayout>

    <!-- App name -->
    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/ds_text_primary"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="-0.01"
        app:layout_constraintTop_toBottomOf="@id/lockIconFrame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvLockSubtitle"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvLockSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/enter_pin"
        android:textColor="@color/ds_text_secondary"
        android:textSize="14sp"
        android:letterSpacing="0.01"
        app:layout_constraintTop_toBottomOf="@id/tvLockTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/etPin"/>

    <!-- Segmented PIN-dot indicator — purely visual, no focus of its own.
         Tapping it focuses the hidden etPin below to bring up the keyboard. -->
    <com.duoshield.app.ui.PinDotsView
        android:id="@+id/pinDotsView"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toBottomOf="@id/tvLockSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvError"/>

    <!-- Hidden PIN input — captures the keyboard, auto-submits; never shown to the
         user directly. Kept at 0dp so IME insertion/backspace events still work. -->
    <EditText
        android:id="@+id/etPin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@null"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:imeOptions="actionDone"
        app:layout_constraintTop_toTopOf="@id/pinDotsView"
        app:layout_constraintStart_toStartOf="@id/pinDotsView"/>

    <!-- Error message -->
    <TextView
        android:id="@+id/tvError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ds_danger"
        android:textSize="13sp"
        android:gravity="center"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/etPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- Biometric button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometric"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="@string/use_biometric"
        android:drawableStart="@drawable/ic_fingerprint"
        android:drawablePadding="10dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        app:strokeColor="@color/ds_divider"
        app:cornerRadius="28dp"
        android:textColor="@color/ds_accent"
        app:iconTint="@color/ds_accent"
        android:visibility="gone"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnUnlock"/>

    <!-- Manual submit fallback — PIN entry auto-submits at 4–6 digits (see
         LockScreenActivity's debounced TextWatcher), so this stays low-emphasis
         and is only needed for accessibility or if auto-submit doesn't fire. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/unlock"
        android:textAllCaps="false"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:textColor="@color/ds_text_secondary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
