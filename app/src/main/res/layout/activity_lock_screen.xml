<?xml version="1.0" encoding="utf-8"?>
<!--
  Lock Screen — Lavender light design, compact layout for all screen sizes.
  IDs kept for LockScreenActivity.java:
    tvError, btnUnlock (GONE), pinDotsView
    key0–key9, keyBackspace, flLockIcon, ivLockShield, fingerprintScanView
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ls_background"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="24dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="20dp">

        <!-- ── Shield logo ── -->
        <ImageView
            android:id="@+id/ivShieldLogo"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_shield"
            app:tint="@color/ds_accent"
            android:contentDescription="DuoShield"/>

        <!-- App name -->
        <TextView
            android:id="@+id/tvLockTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/ls_key_text"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/lock_tagline"
            android:textColor="@color/ls_tagline"
            android:textSize="12sp"/>

        <!-- ── Lock icon with concentric rings ── -->
        <FrameLayout
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:layout_marginTop="14dp">

            <!-- Outermost ring -->
            <View
                android:layout_width="164dp"
                android:layout_height="164dp"
                android:layout_gravity="center"
                android:alpha="0.22"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Middle ring -->
            <View
                android:layout_width="126dp"
                android:layout_height="126dp"
                android:layout_gravity="center"
                android:alpha="0.38"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Inner ring -->
            <View
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:alpha="0.58"
                android:background="@drawable/bg_lock_ring"/>

            <!-- Lock icon circle — ivLockShield and fingerprintScanView swap here -->
            <FrameLayout
                android:id="@+id/flLockIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_lock_icon_circle"
                android:elevation="4dp">

                <!-- Lock icon — shown by default, hidden during PIN verification scan -->
                <ImageView
                    android:id="@+id/ivLockShield"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:layout_marginBottom="3dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/ds_accent"
                    android:contentDescription="Locked"/>

                <!-- Verification scan animation — shown while checking PIN -->
                <com.duoshield.app.ui.FingerprintScanView
                    android:id="@+id/fingerprintScanView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"/>

            </FrameLayout>

        </FrameLayout>

        <!-- ── "Enter your PIN" ── -->
        <TextView
            android:id="@+id/tvLockSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/enter_pin"
            android:textColor="@color/ls_enter_pin"
            android:textSize="15sp"
            android:fontFamily="sans-serif"
            android:letterSpacing="0.10"
            android:textStyle="normal"/>

        <!-- ── PIN dots ── -->
        <com.duoshield.app.ui.PinDotsView
            android:id="@+id/pinDotsView"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginTop="8dp"
            android:clickable="false"
            android:focusable="false"/>

        <!-- Error message -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ds_danger"
            android:textSize="12sp"
            android:gravity="center"
            android:minHeight="16dp"
            android:visibility="invisible"/>

        <!-- ── Custom numpad ── -->
        <LinearLayout
            android:id="@+id/llNumpad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical"
            android:gravity="center">

            <!-- Row 1: 1, 2, 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <LinearLayout android:id="@+id/key1"
                    style="@style/NumpadKey">
                    <TextView android:text="1" style="@style/NumpadDigit"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key2"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="12dp">
                    <TextView android:text="2" style="@style/NumpadDigit"/>
                    <TextView android:text="ABC" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key3"
                    style="@style/NumpadKey">
                    <TextView android:text="3" style="@style/NumpadDigit"/>
                    <TextView android:text="DEF" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: 4, 5, 6 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <LinearLayout android:id="@+id/key4"
                    style="@style/NumpadKey">
                    <TextView android:text="4" style="@style/NumpadDigit"/>
                    <TextView android:text="GHI" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key5"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="12dp">
                    <TextView android:text="5" style="@style/NumpadDigit"/>
                    <TextView android:text="JKL" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key6"
                    style="@style/NumpadKey">
                    <TextView android:text="6" style="@style/NumpadDigit"/>
                    <TextView android:text="MNO" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 3: 7, 8, 9 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <LinearLayout android:id="@+id/key7"
                    style="@style/NumpadKey">
                    <TextView android:text="7" style="@style/NumpadDigit"/>
                    <TextView android:text="PQRS" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key8"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="12dp">
                    <TextView android:text="8" style="@style/NumpadDigit"/>
                    <TextView android:text="TUV" style="@style/NumpadLetters"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/key9"
                    style="@style/NumpadKey">
                    <TextView android:text="9" style="@style/NumpadDigit"/>
                    <TextView android:text="WXYZ" style="@style/NumpadLetters"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 4: [empty], 0, [backspace] -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Placeholder matching key size so 0 stays centered -->
                <View
                    android:layout_width="64dp"
                    android:layout_height="64dp"/>

                <LinearLayout android:id="@+id/key0"
                    style="@style/NumpadKey"
                    android:layout_marginHorizontal="12dp">
                    <TextView android:text="0" style="@style/NumpadDigit"/>
                </LinearLayout>

                <!-- Backspace key -->
                <FrameLayout
                    android:id="@+id/keyBackspace"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_numpad_backspace"
                    android:elevation="5dp"
                    android:outlineProvider="background"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Delete">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_backspace_ls"
                        android:contentDescription="Backspace"/>
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Hidden unlock button — kept for ButtonPressAnimator ref in Java -->
        <Button
            android:id="@+id/btnUnlock"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </LinearLayout>

</ScrollView>
