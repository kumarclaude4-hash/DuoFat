<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/settingsToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/ds_toolbar"
        app:title="@string/appearance_notifications"
        app:titleTextColor="@color/ds_text_primary"
        app:navigationIcon="@drawable/ic_arrow_back"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- ══ CHAT BACKGROUND ═══════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_chat_background"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <!-- Theme picker: horizontal scroll of gradient swatches -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="16dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:background="@color/ds_surface">

                <!-- Populated programmatically in AppearanceNotificationsSettingsActivity -->
                <LinearLayout
                    android:id="@+id/rowThemePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"/>

            </HorizontalScrollView>

            <!-- ══ BUBBLE STYLE ══════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_bubble_style"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="12dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:background="@color/ds_surface">

                <LinearLayout
                    android:id="@+id/rowBubbleStylePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <!-- ══ BUBBLE COLORS ═════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_bubble_colors"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <!-- ── Live bubble preview ──────────────────────────────────────── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="@color/ds_background"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <!-- Theirs bubble — left-aligned -->
                <LinearLayout
                    android:id="@+id/previewTheirsBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:minWidth="90dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hey there! 👋"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp"
                        android:importantForAccessibility="no"/>
                </LinearLayout>

                <!-- Mine bubble — right-aligned -->
                <LinearLayout
                    android:id="@+id/previewMineBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:minWidth="90dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello! 😊"
                        android:textColor="#DDDDDD"
                        android:textSize="14sp"
                        android:importantForAccessibility="no"/>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bubble_mine_label"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="10dp"
                android:paddingBottom="2dp"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp"
                android:background="@color/ds_surface"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:background="@color/ds_surface">

                <LinearLayout
                    android:id="@+id/rowMineBubblePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bubble_theirs_label"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/ds_text_secondary"
                android:textSize="12sp"
                android:background="@color/ds_surface"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="14dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:background="@color/ds_surface">

                <LinearLayout
                    android:id="@+id/rowTheirsBubblePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <!-- ══ TEXT SIZE ══════════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_text_size"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="2dp"
                android:paddingBottom="12dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:background="@color/ds_surface">

                <LinearLayout
                    android:id="@+id/rowTextSizePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="12dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical"/>
            </HorizontalScrollView>

            <!-- ══ LANGUAGE ═══════════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_appearance"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:id="@+id/rowLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/language"
                        android:textColor="@color/ds_text_primary"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/textLanguageSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/system_default"
                        android:textColor="@color/ds_text_secondary"
                        android:textSize="13sp"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="@color/ds_text_secondary"
                    android:importantForAccessibility="no"/>
            </LinearLayout>

            <!-- ══ NOTIFICATIONS ══════════════════════════════════════════════ -->
            <TextView
                android:text="@string/section_notifications"
                style="@style/SectionHeader"
                android:paddingStart="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_send"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/push_notifications"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="15sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@color/ds_surface"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_lock"
                    app:tint="#9A81FF"
                    android:layout_marginEnd="18dp"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Message previews"
                    android:textColor="@color/ds_text_primary"
                    android:textSize="15sp"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchNotificationPreviews"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
