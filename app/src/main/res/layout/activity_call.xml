<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Remote video (full screen) -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteVideoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Voice-only background with avatar -->
    <LinearLayout
        android:id="@+id/voiceOnlyBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#191620">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp">
            <TextView
                android:id="@+id/tvCallAvatarInitial"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"
                android:background="@drawable/bg_avatar_circle"
                android:text="?" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCallPartnerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting…"
            android:textColor="#A0A0A0"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#9A81FF"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Local video PiP (top-right corner) -->
    <FrameLayout
        android:id="@+id/localVideoPip"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="#FF000000"
        android:visibility="gone">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/localVideoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Call controls at the bottom -->
    <LinearLayout
        android:id="@+id/callControlsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="48dp"
        android:paddingTop="16dp">

        <!-- Status row (shown in video mode over remote video) -->
        <TextView
            android:id="@+id/tvCallStatusOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text=""
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Mute -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/btnMute"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_mic"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_circle"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Mute" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mute"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Camera toggle (video only) -->
            <LinearLayout
                android:id="@+id/btnCameraLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnCamera"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_videocam"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_circle"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Camera" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- End call -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/btnEndCall"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_call_end"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_red"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="End call" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Speaker -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <ImageView
                    android:id="@+id/btnSpeaker"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_speaker_on"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_circle"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Speaker" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speaker"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- Flip camera (video only) -->
            <LinearLayout
                android:id="@+id/btnFlipLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnFlipCamera"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_flip_camera"
                    android:padding="16dp"
                    android:background="@drawable/bg_call_btn_circle"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="Flip camera" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Flip"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</FrameLayout>
