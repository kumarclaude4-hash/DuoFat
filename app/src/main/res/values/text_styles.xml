<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── Philosophy: Hierarchy Through Breathing ── -->

    <!-- Headlines — Generous line-height (1.3x), medium weight, warm spacing -->
    <style name="TextAppearance.DuoShield.Display" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.DuoShield.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">24sp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
        <item name="android:letterSpacing">-0.005</item>
    </style>

    <style name="TextAppearance.DuoShield.Subheading" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <!-- Body text — Readable size (16sp minimum), 1.5x line-height for comfort -->
    <style name="TextAppearance.DuoShield.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ds_text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.DuoShield.BodyMedium" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <!-- Captions — Subtle, never cramped, always readable -->
    <style name="TextAppearance.DuoShield.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ds_text_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.DuoShield.Label" parent="TextAppearance.MaterialComponents.Overline">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ds_accent</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Chat Specific -->
    <style name="TextAppearance.DuoShield.ChatMessage" parent="TextAppearance.DuoShield.Body">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.DuoShield.Timestamp" parent="TextAppearance.DuoShield.Caption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ds_text_timestamp</item>
    </style>

    <!-- UI Elements -->
    <style name="TextAppearance.DuoShield.ToolbarTitle" parent="TextAppearance.DuoShield.Headline">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TextAppearance.DuoShield.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DuoShield.Error" parent="TextAppearance.DuoShield.Caption">
        <item name="android:textColor">@color/ds_danger</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/ds_accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:background">@color/ds_divider</item>
    </style>
</resources>
