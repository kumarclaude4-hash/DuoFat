# Local development secrets for `wrangler dev`.
# Copy this file to `.dev.vars` and fill in real values.
# `.dev.vars` is gitignored — never commit real credentials.
#
# These mirror the secrets set in the Cloudflare dashboard via:
#   npx wrangler secret put <NAME>

# Backblaze B2 credentials (S3-compatible)
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=

# Operator-only /stats auth token (S08-H1). This is a DEDICATED operator secret
# that must never be shipped to a client. It replaces the old WORKER_SECRET,
# which was compiled into every APK's BuildConfig and therefore leaked publicly.
# The media data plane (GET/PUT/DELETE) uses a per-object capability token
# (see MEDIA_TOKEN_SECRET), not a shared secret. Generate a fresh value, e.g.
#   openssl rand -hex 32
# then set it via `npx wrangler secret put STATS_SECRET` in the dashboard.
# The Worker fails closed (401 on /stats) if this is unset.
# NOTE: the historical WORKER_SECRET is now unused by the Worker; retire it and
# do not reuse its (leaked) value here.
STATS_SECRET=

# SEC-A01 media capability-token signing secret. REQUIRED — the Worker fails
# closed (503 on all media) if this is unset. Must be byte-identical to the
# push server's MEDIA_TOKEN_SECRET env var. Generate once, e.g.
#   openssl rand -base64 48
# then set it in both places:
#   npx wrangler secret put MEDIA_TOKEN_SECRET     (Worker)
#   MEDIA_TOKEN_SECRET=<same value>                (push server env)
# NEVER compile this into the Android APK — that is the weakness it replaces.
MEDIA_TOKEN_SECRET=

# Server-to-server token for POST /adminLockout (the admin brute-force
# lockout counter, backed by the ADMIN_LOCKOUT_DO Durable Object — see
# src/adminLockoutDurableObject.js). REQUIRED — the Worker fails closed (401)
# if this is unset. Must be byte-identical to Render's
# ADMIN_LOCKOUT_WORKER_SECRET env var (see server/README.md). Generate once:
#   openssl rand -base64 48
# then set it in both places:
#   npx wrangler secret put ADMIN_LOCKOUT_SECRET   (Worker)
#   ADMIN_LOCKOUT_WORKER_SECRET=<same value>       (Render)
# This is a distinct secret from STATS_SECRET on purpose: one authenticates
# Render's server-to-server calls, the other an operator's browser session.
ADMIN_LOCKOUT_SECRET=
