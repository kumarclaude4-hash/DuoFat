<?xml version="1.0" encoding="UTF-8"?>
<!--
  SC-03 - Gradle dependency verification (SCAFFOLD).

  Gradle currently applies no integrity checking to the Maven/Google artifacts it
  downloads, so a compromised repository, cache, or MITM could substitute a
  modified androidx/Firebase/ZXing/Glide artifact and the build would accept it.
  This file is the mechanism that closes that gap: when verify-metadata is true,
  Gradle refuses to use any artifact whose checksum is not recorded in the
  components list below.

  Why this is committed with verification DISABLED:
  Populating the components list requires running Gradle against the full
  dependency graph (the "write-verification-metadata sha256,sha512" gradlew
  task), which needs the JDK + Android SDK + Gradle toolchain. That toolchain is
  not available in the environment that authored this scaffold (AND/Gradle lane
  BLOCKED), and a verification file with verify-metadata set to true but no
  components would fail EVERY build - a worse outcome than the status quo. So the
  mechanism is landed here inert-but-present, and enabling it is a tracked
  operator step.

  OPERATOR RUNBOOK to finish SC-03 (see security-remediation/sessions/SESSION-S3-03.md
  for the exact commands, which contain double-hyphen flags that cannot be written
  inside an XML comment):
    1. Generate hashes for the real resolved graph with the gradlew
       write-verification-metadata task (sha256,sha512) over the assemble tasks.
    2. Review the diff - every added checksum must be an artifact you expect.
    3. Flip verify-metadata to true (leave verify-signatures false unless you also
       add a trusted-keys section).
    4. Run a clean refresh-dependencies build to confirm it passes with
       verification on, then commit.
  Note: the vendored app/libs/libsignal-client-0.54.1-stripped.jar is a files(...)
  dependency, NOT covered by this metadata - its integrity is gated separately by
  "scripts/strip_signal_records.py --check" (SC-01).
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification"
                       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                       xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.3.xsd">
   <configuration>
      <!-- Flip to true once the components list is populated (see runbook above). -->
      <verify-metadata>false</verify-metadata>
      <!-- PGP signature verification is opt-in and needs trusted-keys; keep off
           until checksum verification is proven working. -->
      <verify-signatures>false</verify-signatures>
   </configuration>
   <!-- Populated by the gradlew write-verification-metadata (sha256,sha512) task. -->
   <components/>
</verification-metadata>
